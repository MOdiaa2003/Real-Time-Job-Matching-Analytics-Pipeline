{
  "title": "Kafka - consumer lag & throughput",
  "uid": "job-matching-kafka",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Consumer group lag (sum per group)",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer lag per topic/group",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "sum by (topic, consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{topic}} @ {{consumergroup}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Topic input rate (messages/sec)",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[2m]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Lagging groups (>0 lag right now)",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "count(kafka_consumergroup_lag > 0)"
        }
      ]
    }
  ]
}
