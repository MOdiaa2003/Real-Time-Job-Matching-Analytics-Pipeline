# ─────────────────────────────────────────────────────────────────────
# Real-Time Job Matching Pipeline - environment template
# Copy to .env before starting:  copy .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── PostgreSQL (source) ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host seen from inside the Kafka Connect container (the service name,
# never "localhost") - used by the Debezium connector config.
DEBEZIUM_DB_HOST=postgres
DEBEZIUM_TOPIC_PREFIX=talent
DEBEZIUM_CONNECTOR_NAME=candidate-job-matching-cdc
DEBEZIUM_SLOT_NAME=talent_cdc_slot

# ── PostgreSQL (analytics sink for JDBC connectors) ───────────────────
ANALYTICS_POSTGRES_HOST=localhost
ANALYTICS_POSTGRES_PORT=5433
ANALYTICS_POSTGRES_DB=analytics
ANALYTICS_POSTGRES_USER=postgres
ANALYTICS_POSTGRES_PASSWORD=postgres

# ── Kafka (Apache Kafka, KRaft single node) ───────────────────────────
# Host-side apps (Spark, generators) use the EXTERNAL listener on 9092.
KAFKA_EXTERNAL_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_INTERNAL=kafka:29092
CLUSTER_ID=ClSANk3SRoCNmBDdFxI8Dw

# ── Schema Registry / Connect / ksqlDB ────────────────────────────────
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONNECT_URL=http://localhost:8083
KSQLDB_URL=http://localhost:8088

# ── Spark match engine (run on host; local paths) ─────────────────────
CHECKPOINT_ROOT=checkpoint
DELTA_ROOT=streaming_lake
SPARK_LOCAL_CORES=2
SPARK_PARQUET_CODEC=uncompressed
METRICS_LOG_PATH=streaming_lake/_metrics/batch_metrics.jsonl

# ── Topic names (keep in sync with common/config.py + connectors/) ────
TOPIC_CANDIDATE_EVENTS=candidate_events
TOPIC_JOB_EVENTS=job_events
TOPIC_APPLICATION_EVENTS=application_events
TOPIC_APP_SUBMITTED=application_submitted_events
TOPIC_APP_DEDUP=application_submitted_dedup
TOPIC_JOB_METRICS=job_metrics_5m
TOPIC_APP_ALERTS=application_alerts
TOPIC_MATCH_INVALIDATION=match_invalidation_events

# ── Business thresholds / windows ─────────────────────────────────────
METRICS_WINDOW_MINUTES=5
METRICS_GRACE_MINUTES=2            # event-time grace period for late events
ALERT_WINDOW_MINUTES=10            # spam-detection hopping window
ALERT_APPLY_LIMIT=5                # > N jobs per candidate per window -> alert
DUPLICATION_STATE_RETENTION=30m    # dedup state store retention
FRESHNESS_TARGET_SECONDS=10        # SLA: closure -> invalidation latency

# ── Generator defaults (override via CLI flags) ───────────────────────
JOB_CLOSE_RATE=0.0                 # extra weight for status -> closed
JOB_REOPEN_RATE=0.0
PROFILE_UPDATE_RATE=0.0            # (candidate, update) extra weight
APP_STATUS_TRANSITION_RATE=0.0
